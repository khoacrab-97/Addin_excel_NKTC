{
  "name": "construction-daily-log",
  "version": "0.1.0",
  "description": "Excel Add-in lập nhật ký thi công theo ngày và xuất theo form mẫu.",
  "private": true,
  "license": "UNLICENSED",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "browserslist": [
    "ie 11",
    "edge >= 18",
    "chrome >= 80"
  ],
  "dependencies": {
    "@fluentui/react": "8.125.10",
    "core-js": "3.51.0",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@types/office-js": "1.0.615",
    "@types/react": "17.0.93",
    "@types/react-dom": "17.0.26",
    "babel-loader": "9.2.1",
    "copy-webpack-plugin": "14.0.0",
    "html-webpack-plugin": "5.6.8",
    "office-addin-debugging": "7.0.1",
    "office-addin-dev-certs": "3.0.1",
    "office-addin-manifest": "3.0.1",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "6.1.0"
  }
}
