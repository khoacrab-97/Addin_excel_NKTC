      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/khoacrab-97/Addin_excel_NKTC"/>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Nhật ký thi công đã sẵn sàng"/>
        <bt:String id="Tab.Label" DefaultValue="Nhật ký thi công"/>
        <bt:String id="GroupExport.Label" DefaultValue="Xuất nhật ký"/>
        <bt:String id="GroupForm.Label" DefaultValue="Form mẫu"/>
        <bt:String id="GroupDays.Label" DefaultValue="Chuyển ngày"/>
        <bt:String id="GroupUtilities.Label" DefaultValue="Tiện ích"/>
        <bt:String id="ExportDaily.Label" DefaultValue="Xuất theo ngày"/>
        <bt:String id="SetSource.Label" DefaultValue="Vùng nguồn"/>
        <bt:String id="AssignCell.Label" DefaultValue="Gán cột"/>
        <bt:String id="MappingList.Label" DefaultValue="Danh sách gán"/>
        <bt:String id="DayFirst.Label" DefaultValue="Ngày đầu"/>
        <bt:String id="DayPrev.Label" DefaultValue="Ngày trước"/>
        <bt:String id="DayNext.Label" DefaultValue="Ngày sau"/>
        <bt:String id="DayLast.Label" DefaultValue="Ngày cuối"/>
        <bt:String id="GoToDay.Label" DefaultValue="Đến ngày…"/>
        <bt:String id="Help.Label" DefaultValue="Hướng dẫn"/>
