<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>2b55386a-bc23-4f8d-81e4-137b8271b9ea</Id>
  <Version>1.7.0.0</Version>
  <ProviderName>khoacrab-97</ProviderName>
  <DefaultLocale>vi-VN</DefaultLocale>
  <DisplayName DefaultValue="Nhật ký thi công"/>
  <Description DefaultValue="Lập nhật ký thi công theo ngày và xuất theo form mẫu."/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/khoacrab-97/Addin_excel_NKTC"/>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <!-- Excel 2016 (bản mua một lần) chỉ hỗ trợ ExcelApi 1.1 → đặt làm mức tối thiểu (BUSINESS_SPEC Q6). -->
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <!-- Trang không giao diện chạy lệnh của các nút (ExecuteFunction). Không có khung làm việc bên phải. -->
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="NKTC.Tab">
                <Group id="NKTC.GroupExport">
                  <Label resid="GroupExport.Label"/>
                  <Icon>
                    <bt:Image size="16" resid="Icon.export.16"/>
                    <bt:Image size="32" resid="Icon.export.32"/>
                    <bt:Image size="80" resid="Icon.export.80"/>
                  </Icon>
                  <Control xsi:type="Button" id="NKTC.CreateTable">
                    <Label resid="CreateTable.Label"/>
                    <Supertip>
                      <Title resid="CreateTable.Label"/>
                      <Description resid="CreateTable.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.table.16"/>
                      <bt:Image size="32" resid="Icon.table.32"/>
                      <bt:Image size="80" resid="Icon.table.80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>nktcCreateTable</FunctionName>
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="NKTC.ExportDaily">
                    <Label resid="ExportDaily.Label"/>
                    <Supertip>
                      <Title resid="ExportDaily.Label"/>
                      <Description resid="ExportDaily.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.export.16"/>
                      <bt:Image size="32" resid="Icon.export.32"/>
                      <bt:Image size="80" resid="Icon.export.80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>nktcExportDaily</FunctionName>
                    </Action>
                  </Control>
                </Group>
                <Group id="NKTC.GroupForm">
                  <Label resid="GroupForm.Label"/>
                  <Icon>
                    <bt:Image size="16" resid="Icon.assign.16"/>
                    <bt:Image size="32" resid="Icon.assign.32"/>
                    <bt:Image size="80" resid="Icon.assign.80"/>
                  </Icon>
                  <Control xsi:type="Button" id="NKTC.InsertTemplate">
                    <Label resid="InsertTemplate.Label"/>
                    <Supertip>
                      <Title resid="InsertTemplate.Label"/>
                      <Description resid="InsertTemplate.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.template.16"/>
                      <bt:Image size="32" resid="Icon.template.32"/>
                      <bt:Image size="80" resid="Icon.template.80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>nktcInsertTemplate</FunctionName>
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="NKTC.ExportForm">
                    <Label resid="ExportForm.Label"/>
                    <Supertip>
                      <Title resid="ExportForm.Label"/>
                      <Description resid="ExportForm.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.assign.16"/>
                      <bt:Image size="32" resid="Icon.assign.32"/>
                      <bt:Image size="80" resid="Icon.assign.80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>nktcExportForm</FunctionName>
                    </Action>
                  </Control>
                </Group>
                <Group id="NKTC.GroupDays">
                  <Label resid="GroupDays.Label"/>
                  <Icon>
                    <bt:Image size="16" resid="Icon.next.16"/>
                    <bt:Image size="32" resid="Icon.next.32"/>
                    <bt:Image size="80" resid="Icon.next.80"/>
                  </Icon>
                  <Control xsi:type="Button" id="NKTC.DayFirst">
                    <Label resid="DayFirst.Label"/>
                    <Supertip>
                      <Title resid="DayFirst.Label"/>
                      <Description resid="DayFirst.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.first.16"/>
                      <bt:Image size="32" resid="Icon.first.32"/>
                      <bt:Image size="80" resid="Icon.first.80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>nktcDayFirst</FunctionName>
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="NKTC.DayPrev">
                    <Label resid="DayPrev.Label"/>
                    <Supertip>
                      <Title resid="DayPrev.Label"/>
                      <Description resid="DayPrev.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.prev.16"/>
                      <bt:Image size="32" resid="Icon.prev.32"/>
                      <bt:Image size="80" resid="Icon.prev.80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>nktcDayPrev</FunctionName>
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="NKTC.DayNext">
                    <Label resid="DayNext.Label"/>
                    <Supertip>
                      <Title resid="DayNext.Label"/>
                      <Description resid="DayNext.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.next.16"/>
                      <bt:Image size="32" resid="Icon.next.32"/>
                      <bt:Image size="80" resid="Icon.next.80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>nktcDayNext</FunctionName>
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="NKTC.DayLast">
                    <Label resid="DayLast.Label"/>
                    <Supertip>
                      <Title resid="DayLast.Label"/>
                      <Description resid="DayLast.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.last.16"/>
                      <bt:Image size="32" resid="Icon.last.32"/>
                      <bt:Image size="80" resid="Icon.last.80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>nktcDayLast</FunctionName>
                    </Action>
                  </Control>
                </Group>
                <Group id="NKTC.GroupUtilities">
                  <Label resid="GroupUtilities.Label"/>
                  <Icon>
                    <bt:Image size="16" resid="Icon.help.16"/>
                    <bt:Image size="32" resid="Icon.help.32"/>
                    <bt:Image size="80" resid="Icon.help.80"/>
                  </Icon>
                  <Control xsi:type="Menu" id="NKTC.UtilitiesMenu">
                    <Label resid="GroupUtilities.Label"/>
                    <Supertip>
                      <Title resid="GroupUtilities.Label"/>
                      <Description resid="Utilities.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.help.16"/>
                      <bt:Image size="32" resid="Icon.help.32"/>
                      <bt:Image size="80" resid="Icon.help.80"/>
                    </Icon>
                    <Items>
                      <Item id="NKTC.Help">
                        <Label resid="Help.Label"/>
                        <Supertip>
                          <Title resid="Help.Label"/>
                          <Description resid="Help.Tip"/>
                        </Supertip>
                        <Icon>
                          <bt:Image size="16" resid="Icon.help.16"/>
                          <bt:Image size="32" resid="Icon.help.32"/>
                          <bt:Image size="80" resid="Icon.help.80"/>
                        </Icon>
                        <Action xsi:type="ExecuteFunction">
                          <FunctionName>nktcHelp</FunctionName>
                        </Action>
                      </Item>
                      <Item id="NKTC.About">
                        <Label resid="About.Label"/>
                        <Supertip>
                          <Title resid="About.Label"/>
                          <Description resid="About.Tip"/>
                        </Supertip>
                        <Icon>
                          <bt:Image size="16" resid="Icon.about.16"/>
                          <bt:Image size="32" resid="Icon.about.32"/>
                          <bt:Image size="80" resid="Icon.about.80"/>
                        </Icon>
                        <Action xsi:type="ExecuteFunction">
                          <FunctionName>nktcAbout</FunctionName>
                        </Action>
                      </Item>
                    </Items>
                  </Control>
                </Group>
              <Label resid="Tab.Label"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/assets/icon-80.png"/>
        <bt:Image id="Icon.table.16" DefaultValue="https://localhost:3000/assets/ribbon/table-16.png"/>
        <bt:Image id="Icon.table.32" DefaultValue="https://localhost:3000/assets/ribbon/table-32.png"/>
        <bt:Image id="Icon.table.80" DefaultValue="https://localhost:3000/assets/ribbon/table-80.png"/>
        <bt:Image id="Icon.export.16" DefaultValue="https://localhost:3000/assets/ribbon/export-16.png"/>
        <bt:Image id="Icon.export.32" DefaultValue="https://localhost:3000/assets/ribbon/export-32.png"/>
        <bt:Image id="Icon.export.80" DefaultValue="https://localhost:3000/assets/ribbon/export-80.png"/>
        <bt:Image id="Icon.template.16" DefaultValue="https://localhost:3000/assets/ribbon/template-16.png"/>
        <bt:Image id="Icon.template.32" DefaultValue="https://localhost:3000/assets/ribbon/template-32.png"/>
        <bt:Image id="Icon.template.80" DefaultValue="https://localhost:3000/assets/ribbon/template-80.png"/>
        <bt:Image id="Icon.assign.16" DefaultValue="https://localhost:3000/assets/ribbon/assign-16.png"/>
        <bt:Image id="Icon.assign.32" DefaultValue="https://localhost:3000/assets/ribbon/assign-32.png"/>
        <bt:Image id="Icon.assign.80" DefaultValue="https://localhost:3000/assets/ribbon/assign-80.png"/>
        <bt:Image id="Icon.first.16" DefaultValue="https://localhost:3000/assets/ribbon/first-16.png"/>
        <bt:Image id="Icon.first.32" DefaultValue="https://localhost:3000/assets/ribbon/first-32.png"/>
        <bt:Image id="Icon.first.80" DefaultValue="https://localhost:3000/assets/ribbon/first-80.png"/>
        <bt:Image id="Icon.prev.16" DefaultValue="https://localhost:3000/assets/ribbon/prev-16.png"/>
        <bt:Image id="Icon.prev.32" DefaultValue="https://localhost:3000/assets/ribbon/prev-32.png"/>
        <bt:Image id="Icon.prev.80" DefaultValue="https://localhost:3000/assets/ribbon/prev-80.png"/>
        <bt:Image id="Icon.next.16" DefaultValue="https://localhost:3000/assets/ribbon/next-16.png"/>
        <bt:Image id="Icon.next.32" DefaultValue="https://localhost:3000/assets/ribbon/next-32.png"/>
        <bt:Image id="Icon.next.80" DefaultValue="https://localhost:3000/assets/ribbon/next-80.png"/>
        <bt:Image id="Icon.last.16" DefaultValue="https://localhost:3000/assets/ribbon/last-16.png"/>
        <bt:Image id="Icon.last.32" DefaultValue="https://localhost:3000/assets/ribbon/last-32.png"/>
        <bt:Image id="Icon.last.80" DefaultValue="https://localhost:3000/assets/ribbon/last-80.png"/>
        <bt:Image id="Icon.help.16" DefaultValue="https://localhost:3000/assets/ribbon/help-16.png"/>
        <bt:Image id="Icon.help.32" DefaultValue="https://localhost:3000/assets/ribbon/help-32.png"/>
        <bt:Image id="Icon.help.80" DefaultValue="https://localhost:3000/assets/ribbon/help-80.png"/>
        <bt:Image id="Icon.about.16" DefaultValue="https://localhost:3000/assets/ribbon/about-16.png"/>
        <bt:Image id="Icon.about.32" DefaultValue="https://localhost:3000/assets/ribbon/about-32.png"/>
        <bt:Image id="Icon.about.80" DefaultValue="https://localhost:3000/assets/ribbon/about-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/khoacrab-97/Addin_excel_NKTC"/>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Nhật ký thi công đã sẵn sàng"/>
        <bt:String id="Tab.Label" DefaultValue="Nhật ký thi công"/>
        <bt:String id="GroupExport.Label" DefaultValue="Tiến độ"/>
        <bt:String id="GroupForm.Label" DefaultValue="Form mẫu"/>
        <bt:String id="GroupDays.Label" DefaultValue="Chuyển ngày"/>
        <bt:String id="GroupUtilities.Label" DefaultValue="Tiện ích"/>
        <bt:String id="CreateTable.Label" DefaultValue="Tạo bảng"/>
        <bt:String id="ExportDaily.Label" DefaultValue="Xuất theo ngày"/>
        <bt:String id="InsertTemplate.Label" DefaultValue="Chèn form mẫu"/>
        <bt:String id="ExportForm.Label" DefaultValue="Xuất vào form"/>
        <bt:String id="DayFirst.Label" DefaultValue="Ngày đầu"/>
        <bt:String id="DayPrev.Label" DefaultValue="Ngày trước"/>
        <bt:String id="DayNext.Label" DefaultValue="Ngày sau"/>
        <bt:String id="DayLast.Label" DefaultValue="Ngày cuối"/>
        <bt:String id="Help.Label" DefaultValue="Hướng dẫn"/>
        <bt:String id="About.Label" DefaultValue="Phiên bản"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Mở tab Nhật ký thi công trên thanh Ribbon để bắt đầu."/>
        <bt:String id="CreateTable.Tip" DefaultValue="Tạo bảng nhập tiến độ STT | Nội dung công việc | Bắt đầu | Kết thúc (sheet mới hoặc sheet hiện tại, mặc định 10 dòng) để tự điền dữ liệu."/>
        <bt:String id="ExportDaily.Tip" DefaultValue="Chọn bảng tiến độ (hoặc đặt con trỏ trong sheet tiến độ), xác nhận 3 cột rồi tạo sheet NK_TheoNgay."/>
        <bt:String id="InsertTemplate.Tip" DefaultValue="Thêm sheet biểu mẫu &quot;Mẫu NKTC&quot; (Tình hình thi công hàng ngày) đã dựng sẵn vào file."/>
        <bt:String id="ExportForm.Tip" DefaultValue="Chọn vùng nhật ký theo ngày, gán từng cột vào ô của biểu mẫu rồi bấm Gán. Sau khi gán mới dùng được các nút Chuyển ngày."/>
        <bt:String id="DayFirst.Tip" DefaultValue="Ghi dữ liệu ngày đầu tiên lên biểu mẫu."/>
        <bt:String id="DayPrev.Tip" DefaultValue="Ghi dữ liệu ngày trước đó lên biểu mẫu."/>
        <bt:String id="DayNext.Tip" DefaultValue="Ghi dữ liệu ngày kế tiếp lên biểu mẫu."/>
        <bt:String id="DayLast.Tip" DefaultValue="Ghi dữ liệu ngày cuối cùng lên biểu mẫu."/>
        <bt:String id="Help.Tip" DefaultValue="Hướng dẫn sử dụng và tải biểu mẫu."/>
        <bt:String id="Utilities.Tip" DefaultValue="Hướng dẫn sử dụng, phiên bản add-in và kiểm tra cập nhật."/>
        <bt:String id="About.Tip" DefaultValue="Phiên bản add-in, môi trường Excel và kiểm tra cập nhật."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
