      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Mở tab Nhật ký thi công trên thanh Ribbon để bắt đầu."/>
        <bt:String id="ExportDaily.Tip" DefaultValue="Chọn bảng tiến độ (hoặc đặt con trỏ trong sheet tiến độ), xác nhận 3 cột rồi tạo sheet NK_TheoNgay."/>
        <bt:String id="SetSource.Tip" DefaultValue="Đặt con trỏ trong bảng nhật ký theo ngày (NK_TheoNgay) rồi bấm để làm nguồn dữ liệu cho biểu mẫu."/>
        <bt:String id="AssignCell.Tip" DefaultValue="Chọn một ô (hoặc ô merge) trên biểu mẫu rồi bấm để chọn cột ghi vào ô đó."/>
        <bt:String id="MappingList.Tip" DefaultValue="Xem các ô đã gán, bỏ gán, đổi cột Ngày."/>
        <bt:String id="DayFirst.Tip" DefaultValue="Ghi dữ liệu ngày đầu tiên lên biểu mẫu."/>
        <bt:String id="DayPrev.Tip" DefaultValue="Ghi dữ liệu ngày trước đó lên biểu mẫu."/>
        <bt:String id="DayNext.Tip" DefaultValue="Ghi dữ liệu ngày kế tiếp lên biểu mẫu."/>
        <bt:String id="DayLast.Tip" DefaultValue="Ghi dữ liệu ngày cuối cùng lên biểu mẫu."/>
        <bt:String id="GoToDay.Tip" DefaultValue="Nhập ngày (dd/mm/yyyy) để ghi dữ liệu ngày đó lên biểu mẫu."/>
        <bt:String id="Help.Tip" DefaultValue="Hướng dẫn sử dụng và tải biểu mẫu."/>
        <bt:String id="About.Tip" DefaultValue="Phiên bản add-in, môi trường Excel và kiểm tra cập nhật."/>
